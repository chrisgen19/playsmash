// Playsmash — Phase 1 schema
// Auth.js (User/Account/Session/VerificationToken) + group/membership/player core.
// Session play models (Court, SessionPlayer, Match, ScoreEvent, ActivityLog) arrive in later phases.

generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Auth.js (NextAuth v5) models
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  firstName     String?
  lastName      String?
  name          String? // Full name — Auth.js/session uses this; we keep it as `${firstName} ${lastName}`.
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  groupsCreated      Group[]         @relation("GroupCreatedBy")
  groupMemberships   GroupMember[]
  playerProfiles     PlayerProfile[] @relation("PlayerProfileUser")
  playerProfilesByMe PlayerProfile[] @relation("PlayerProfileCreatedBy")
  invitesCreated     Invite[]        @relation("InviteCreatedBy")
  joinRequests       JoinRequest[]
  activityLogs       ActivityLog[]
  sessionsCreated    PlaySession[]   @relation("PlaySessionCreatedBy")

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// Domain — groups, members, players, invites, join requests
// -----------------------------------------------------------------------------

enum GroupVisibility {
  PRIVATE
  INVITE_ONLY
  PUBLIC
}

enum GroupRole {
  OWNER
  ADMIN
  PLAYER
  VIEWER
}

enum GroupMemberStatus {
  ACTIVE
  INVITED
  LEFT
  REMOVED
  BANNED
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
  TEMPORARY
  REMOVED
}

enum InviteStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Group {
  id              String          @id @default(cuid())
  name            String
  description     String?
  createdByUserId String
  joinCode        String          @unique
  visibility      GroupVisibility @default(INVITE_ONLY)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy    User            @relation("GroupCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members      GroupMember[]
  players      PlayerProfile[]
  invites      Invite[]
  joinRequests JoinRequest[]
  activityLogs ActivityLog[]
  sessions     PlaySession[]
  courts       Court[]

  @@index([createdByUserId])
}

model GroupMember {
  id        String            @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole         @default(PLAYER)
  status    GroupMemberStatus @default(ACTIVE)
  joinedAt  DateTime          @default(now())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([role])
}

model PlayerProfile {
  id              String       @id @default(cuid())
  groupId         String
  userId          String?
  displayName     String
  skillLevel      Float?
  gender          String?
  handedness      String?
  notes           String?
  status          PlayerStatus @default(ACTIVE)
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User?           @relation("PlayerProfileUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("PlayerProfileCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  sessionPlayers SessionPlayer[]
  matchT1P1      Match[]         @relation("MatchT1P1")
  matchT1P2      Match[]         @relation("MatchT1P2")
  matchT2P1      Match[]         @relation("MatchT2P1")
  matchT2P2      Match[]         @relation("MatchT2P2")

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model Invite {
  id              String       @id @default(cuid())
  groupId         String
  code            String       @unique
  createdByUserId String
  expiresAt       DateTime?
  maxUses         Int?
  usedCount       Int          @default(0)
  status          InviteStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation("InviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([groupId])
}

model JoinRequest {
  id        String            @id @default(cuid())
  groupId   String
  userId    String
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
}

// -----------------------------------------------------------------------------
// Activity log — write-side persisted from Phase 2; UI in Phase 8.
// -----------------------------------------------------------------------------

model ActivityLog {
  id         String   @id @default(cuid())
  groupId    String
  userId     String? // null when the actor is the system
  action     String // e.g. "member.role_changed", "player.created_temp"
  targetType String // e.g. "GroupMember", "PlayerProfile", "Invite"
  targetId   String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([targetType, targetId])
}

// -----------------------------------------------------------------------------
// Phase 3 — play sessions, courts, attendance
//
// NOTE: Auth.js owns the `Session` table. The play-session model is named
// `PlaySession` to avoid the clash.
// -----------------------------------------------------------------------------

enum ScoringType {
  RALLY
  SIDE_OUT
  CUSTOM
}

enum PlaySessionStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CourtStatus {
  AVAILABLE
  IN_USE
  DISABLED
}

enum SessionPlayerStatus {
  AVAILABLE
  WAITING
  PLAYING
  RESTING
  LEFT
}

model PlaySession {
  id              String            @id @default(cuid())
  groupId         String
  name            String
  date            DateTime
  location        String?
  numberOfCourts  Int               @default(1)
  scoringType     ScoringType       @default(RALLY)
  pointsToWin     Int               @default(11)
  winByTwo        Boolean           @default(true)
  status          PlaySessionStatus @default(PLANNED)
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User            @relation("PlaySessionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  courts    Court[]
  players   SessionPlayer[]
  matches   Match[]

  @@index([groupId, date])
  @@index([status])
}

model Court {
  id          String      @id @default(cuid())
  groupId     String
  sessionId   String?
  name        String
  courtNumber Int
  status      CourtStatus @default(AVAILABLE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  group   Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  session PlaySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  matches Match[]

  @@index([groupId])
  @@index([sessionId])
}

model SessionPlayer {
  id              String              @id @default(cuid())
  sessionId       String
  playerProfileId String
  status          SessionPlayerStatus @default(AVAILABLE)
  checkInOrder    Int
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  session PlaySession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Restrict)

  @@unique([sessionId, playerProfileId])
  @@index([sessionId, status])
}

// -----------------------------------------------------------------------------
// Phase 4 — matches generated by the stacking algorithm
// -----------------------------------------------------------------------------

enum WinningTeam {
  TEAM_1
  TEAM_2
}

enum MatchStatus {
  QUEUED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Match {
  id              String       @id @default(cuid())
  sessionId       String
  courtId         String?
  roundNumber     Int
  // Doubles uses all four; singles (later) leaves the P2 slots null.
  team1Player1Id  String
  team1Player2Id  String?
  team2Player1Id  String
  team2Player2Id  String?
  team1Score      Int?
  team2Score      Int?
  winningTeam     WinningTeam?
  status          MatchStatus  @default(QUEUED)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  session PlaySession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  court   Court?        @relation(fields: [courtId], references: [id], onDelete: SetNull)
  // Player slots: ON DELETE Restrict to preserve match history. PlayerProfile
  // deletes are soft (status=REMOVED), so this never fires in normal use.
  team1P1 PlayerProfile  @relation("MatchT1P1", fields: [team1Player1Id], references: [id], onDelete: Restrict)
  team1P2 PlayerProfile? @relation("MatchT1P2", fields: [team1Player2Id], references: [id], onDelete: Restrict)
  team2P1 PlayerProfile  @relation("MatchT2P1", fields: [team2Player1Id], references: [id], onDelete: Restrict)
  team2P2 PlayerProfile? @relation("MatchT2P2", fields: [team2Player2Id], references: [id], onDelete: Restrict)

  @@index([sessionId, roundNumber])
  @@index([sessionId, status])
  @@index([courtId])
}
